#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated code (build_runner)
*.freezed.dart
*.g.dart

# flutter_rust_bridge 自动生成（运行 flutter_rust_bridge_codegen generate 后生成）
/lib/rust_bridge/
/lib/src/rust/
/rust/
/rust_builder/

# CocoaPods 安装的依赖（可重新生成）
/macos/Pods/

# Gradle 缓存（Android 构建临时文件）
/android/.gradle/
/android/local.properties

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Rust build artifacts (code_forge patches)
.patches/code_forge/rust/target/
